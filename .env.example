# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase
# (Project Settings > API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# Notificaciones push (opcional). Genera el par con:  npx web-push generate-vapid-keys
# La pública va aquí (y en Vercel); la privada SOLO como secreto de Supabase (ver README).
VITE_VAPID_PUBLIC_KEY=tu-clave-publica-vapid
DATABASE_PASSWORD=tu-contraseña-de-la-base-de-datos